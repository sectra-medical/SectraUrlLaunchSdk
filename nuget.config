<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restrict package sources to the public nuget.org registry only.
    <clear /> drops any inherited machine/user-level feeds so restores are
    reproducible and packages are only fetched from an approved registry.
    This is a public SDK repository, so no internal Sectra feed is referenced.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Drop any inherited disabledPackageSources (e.g. a machine-level config that
       disables nuget.org) so the source added above is actually usable. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
